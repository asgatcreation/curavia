# Curavia — environment template.
#
# Copy this file to `.env` and fill it in. `.env` is gitignored and must never
# be committed. Every value here is deliberately EMPTY: no placeholder that
# looks like a real key, so a copied-and-forgotten line fails loudly instead of
# half-working.
#
#     cp .env.example .env
#
# Nothing below is needed all at once. The "needed from" note on each block
# says which milestone first requires it.

# --------------------------------------------------------------------------
# Django — needed from milestone 2
# --------------------------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Database — needed from milestone 2
# --------------------------------------------------------------------------
# Either set DATABASE_URL (what Neon and most hosts give you)...
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# ...or the individual settings, for a local Postgres.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_CONN_MAX_AGE=60

# --------------------------------------------------------------------------
# Redis — needed from milestone 2 (WebSockets and background jobs)
# --------------------------------------------------------------------------
# Local:    redis://localhost:6379/0
# Upstash:  rediss://default:<password>@<host>:6379
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_WORKER_CONCURRENCY=1
# "celery" or "eager". Use "eager" for a single process with no worker.
BACKGROUND_TASK_BACKEND=celery

# --------------------------------------------------------------------------
# Frontend origins — needed from milestone 3
# --------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# --------------------------------------------------------------------------
# Security
# --------------------------------------------------------------------------
# Staff session idle timeout, in seconds.
SESSION_COOKIE_AGE=3600
# PostgreSQL row-level security. Needs a dedicated non-owner database role —
# see docs/adr/0002-row-level-security.md. Leave off until that role exists.
CURAVIA_ENABLE_RLS=false

# --------------------------------------------------------------------------
# Email — Brevo HTTP API, needed from milestone 5
# --------------------------------------------------------------------------
# HTTP API rather than SMTP: Render's free tier blocks outbound SMTP.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
EMAIL_PROVIDER=brevo

# --------------------------------------------------------------------------
# SMS — Termii, with Twilio as the fallback. Needed from milestone 5
# --------------------------------------------------------------------------
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --------------------------------------------------------------------------
# Payments — Paystack TEST keys only. Needed from milestone 8
# --------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# Private file storage — Cloudflare R2. Needed from milestone 7
# --------------------------------------------------------------------------
# Medical files. Private bucket only, reached through short-lived signed URLs.
# Never a public image CDN.
USE_OBJECT_STORAGE=false
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --------------------------------------------------------------------------
# Video — LiveKit Cloud, needed from milestone 13
# --------------------------------------------------------------------------
VIDEO_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --------------------------------------------------------------------------
# Monitoring — needed from milestone 9
# --------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
GIT_COMMIT=

# --------------------------------------------------------------------------
# Encryption for the most sensitive fields (HIV status, psychiatric notes)
# Needed from milestone 6
# --------------------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_MASTER_KEY=
