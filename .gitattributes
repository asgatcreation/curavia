# Normalise line endings.
#
# Development happens on Windows and CI runs on Linux, so without this the
# repository ends up with a mix of CRLF and LF and every formatter run shows up
# as a whole-file rewrite in the diff. Everything is stored as LF; Git converts
# on checkout where the platform needs it.

* text=auto eol=lf

# Shell scripts and Docker files must be LF even on Windows, or the shell
# inside the container fails on the carriage returns.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
Procfile        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only helpers keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary — never convert, never diff as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.zip           binary
*.gz            binary

# Generated or vendored: keep them out of diffs and language statistics.
package-lock.json         linguist-generated=true -diff
backend/apps/*/migrations/*.py  linguist-generated=true
frontend/shared/src/api/generated.ts linguist-generated=true -diff
