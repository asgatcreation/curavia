{
  "name": "curavia",
  "private": true,
  "version": "0.1.0",
  "description": "Curavia - hospital and clinic operating system",
  "author": "Akanji Oluwaseun Gabriel (@asgatcreation)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "frontend/shared",
    "frontend/staff",
    "frontend/portal"
  ],
  "scripts": {
    "dev:staff": "npm run dev --workspace @curavia/staff",
    "dev:portal": "npm run dev --workspace @curavia/portal",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "types": "openapi-typescript http://localhost:8000/api/v1/schema/ -o frontend/shared/src/api/generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2"
  }
}
